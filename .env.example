# Public API base (client fetches)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# NEXT_PUBLIC_APP_URL=https://tantakuy-hyf.vercel.app
# BASE_URL=/api

# Domain configuration
# production
# DOMAIN=https://tantakuy-hyf.vercel.app
# preview
# DOMAIN=https://tantakuy-hyf.vercel.app

# Database
DB_NAME=tantakuy
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_REGION=eu-north-1
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-bucket-name

# Email Configuration
EMAIL_FROM="Tantakuy Support <no-reply@tantakuy.com>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com

# Rate Limiting (Upstash Redis)
# Required for authentication and API rate limiting
# Sign up at https://upstash.com/ to get your credentials
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
